meta {
  name: Compile template
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/compile
  body: json
  auth: none
}

body:json {
  {
    "template": "invoice",
    "date": "2026-11-07",
    "data": {
      "number": "F-2026-001",
      "date": "2026-11-07",
      "seller": { "name": "Example SAS", "address": "1 rue de la Paix, 75002 Paris" },
      "client": { "name": "ACME", "address": "42 avenue des Champs, 69000 Lyon" },
      "items": [
        { "label": "Consulting", "qty": 3, "price": 650 },
        { "label": "Support plan", "qty": 1, "price": 199 }
      ]
    }
  }
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/pdf
  res.headers["x-pdfq-pages"]: eq "1"
}
